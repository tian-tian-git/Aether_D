;; Aether 标准库 —— 用 Aether 自身实现(M6 自举,WP6.1)
;;
;; 全部函数运行于字节码 VM,并通过 parse + typecheck + Z3 静态契约验证:
;;   aether check lib/aether-std.ae
;; 使用方式(v0.1 无 import):把需要的函数并入你的模块,或整库并入。

(module aether-std

  ;; ---- 聚合 ----

  (fn sum (xs (Vec Int)) -> Int
    (fold (fn (acc Int) (x Int) -> Int (+ acc x)) 0 xs))

  (fn product (xs (Vec Int)) -> Int
    (fold (fn (acc Int) (x Int) -> Int (* acc x)) 1 xs))

  (fn average (xs (Vec Int)) -> Int
    :pre (not (empty? xs))
    (/ (sum xs) (len xs)))

  (fn count (xs (Vec Int)) (v Int) -> Int
    (fold (fn (acc Int) (x Int) -> Int (if (== x v) (+ acc 1) acc)) 0 xs))

  (fn contains (xs (Vec Int)) (v Int) -> Bool
    (fold (fn (found Bool) (x Int) -> Bool (or found (== x v))) false xs))

  (fn all? (xs (Vec Int)) (pred (Fn (Int) -> Bool)) -> Bool
    (fold (fn (acc Bool) (x Int) -> Bool (and acc (pred x))) true xs))

  (fn any? (xs (Vec Int)) (pred (Fn (Int) -> Bool)) -> Bool
    (fold (fn (acc Bool) (x Int) -> Bool (or acc (pred x))) false xs))

  ;; ---- 序列 ----

  (fn reverse (xs (Vec Int)) -> (Vec Int)
    (fold (fn (acc (Vec Int)) (x Int) -> (Vec Int) (concat (vec x) acc)) (vec) xs))

  (fn take (xs (Vec Int)) (n Int) -> (Vec Int)
    :pre (>= n 0)
    (if (or (== n 0) (empty? xs))
        (vec)
        (concat (vec (head xs)) (take (tail xs) (- n 1)))))

  (fn drop (xs (Vec Int)) (n Int) -> (Vec Int)
    :pre (>= n 0)
    (if (or (== n 0) (empty? xs))
        xs
        (drop (tail xs) (- n 1))))

  ;; ---- 排序与查找 ----

  (fn qsort (xs (Vec Int)) -> (Vec Int)
    :post (sorted? result)
    (if (empty? xs)
        xs
        (concat (qsort (filter (fn (x Int) -> Bool (< x (head xs))) xs))
                (vec (head xs))
                (qsort (filter (fn (x Int) -> Bool (> x (head xs))) xs)))))

  (fn kth (xs (Vec Int)) (k Int) -> Int
    :pre (and (>= k 0) (< k (len xs)))
    (get (qsort xs) k))

  (fn insert (xs (Vec Int)) (v Int) -> (Vec Int)
    :pre (sorted? xs)
    (if (empty? xs)
        (vec v)
        (if (<= v (head xs))
            (concat (vec v) xs)
            (concat (vec (head xs)) (insert (tail xs) v)))))

  (fn bsearch-lo (xs (Vec Int)) (v Int) (lo Int) (hi Int) -> Int
    :pre (sorted? xs)
    (if (>= lo hi)
        -1
        (block
          (let mid Int (/ (+ lo hi) 2))
          (let mv Int (get xs mid))
          (if (== mv v)
              mid
              (if (< mv v) (bsearch-lo xs v (+ mid 1) hi) (bsearch-lo xs v lo mid))))))

  (fn bsearch (xs (Vec Int)) (v Int) -> Int
    :pre (sorted? xs)
    (bsearch-lo xs v 0 (len xs)))

  ;; ---- 数学 ----

  (fn dot (a (Vec Int)) (b (Vec Int)) -> Int
    :pre (== (len a) (len b))
    (fold (fn (acc Int) (i Int) -> Int (+ acc (* (get a i) (get b i)))) 0 (range 0 (len a))))

  (fn power (a Int) (b Int) -> Int
    :pre (>= b 0)
    (if (== b 0) 1 (* a (power a (- b 1)))))

  (fn fact (n Int) -> Int
    :pre (>= n 0)
    (if (<= n 1) 1 (* n (fact (- n 1)))))

  (fn fib (n Int) -> Int
    :pre (>= n 0)
    (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

  ;; ---- 演示入口(可运行示例)----
  (fn main () -> Int
    (block
      (let xs (Vec Int) (vec 5 3 1 4 2))
      (out "sum: ")
      (out (sum xs))
      (out "qsort: ")
      (out (qsort xs))
      (out "fib(20): ")
      (out (fib 20))
      0)))
